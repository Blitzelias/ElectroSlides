#include <U8g2lib.h>
#include <Adafruit_NeoPixel.h>
#include <pgmspace.h>

#define SDA_PIN 8
#define SCL_PIN 10
constexpr uint32_t FOLIENZEIT_MS = 4000;
// Interne adressierbare RGB-LED (Carenuity C3 Mini / LOLIN C3 Mini)
// Falls deine Platinenrevision einen anderen Datenpin verwendet, hier anpassen.
constexpr uint8_t RGB_PIN = 7;
constexpr uint8_t RGB_HELLIGKEIT = 50; // 0...255
constexpr uint32_t RGB_SCHRITT_MS = 40; // ganzer Regenbogen in etwa 10,24 s
Adafruit_NeoPixel rgb(1, RGB_PIN, NEO_GRB + NEO_KHZ800);
uint8_t rgbPosition = 0;
uint32_t letzterRgbSchritt = 0;

// Ganz ohne delay(): LED-Animation und OLED-Slideshow laufen gleichzeitig.
uint32_t regenbogenFarbe(uint8_t position) {
  uint8_t p = 255 - position;
  if (p < 85) return rgb.Color(255 - p * 3, 0, p * 3);
  if (p < 170) {
    p -= 85;
    return rgb.Color(0, p * 3, 255 - p * 3);
  }
  p -= 170;
  return rgb.Color(p * 3, 255 - p * 3, 0);
}

void rgbAktualisieren(uint32_t jetzt) {
  if (jetzt - letzterRgbSchritt < RGB_SCHRITT_MS) return;
  letzterRgbSchritt = jetzt;
  rgb.setPixelColor(0, regenbogenFarbe(rgbPosition++));
  rgb.show();
}

U8G2_SSD1306_64X48_ER_F_HW_I2C u8g2(U8G2_R0, U8X8_PIN_NONE);
