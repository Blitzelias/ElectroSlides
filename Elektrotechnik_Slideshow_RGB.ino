  {"IGBT - Name", bmp_igbt_name, 64, 48},
  {"IGBT - Symbol", bmp_igbt_symbol, 64, 48},
  {"IGBT - Anschluesse", bmp_igbt_pins, 64, 48},
  {"Gleichstrommaschine", bmp_dc_title, 64, 48},
  {"1. Hauptgleichung", bmp_dc_ui, 64, 48},
  {"2. Hauptgleichung", bmp_dc_loss, 64, 48},
  {"Motor Bilanz 1", bmp_dc_p1, 64, 48},
  {"Motor Bilanz 2", bmp_dc_p2, 64, 48},
  {"Mechanische Leistung", bmp_dc_pmech, 64, 48},
  {"Erregerleistung", bmp_dc_pf, 64, 48},
};
constexpr uint8_t ANZAHL = sizeof(folien) / sizeof(folien[0]);
uint8_t aktuelleFolie = 0;
uint32_t folieBeginn = 0;

void folieAnzeigen(uint32_t seitBeginn) {
  if (!oledGefunden) return;
  const Folie& f = folien[aktuelleFolie];
  int16_t x = 0;
  int16_t y = (48 - f.hoehe) / 2;
  if (f.breite > 64) {
    // Alle Formeln passen jetzt vollstaendig auf 64x48.
    const int16_t startX = 2;
    const int16_t endX = 64 - f.breite - 2;
    const uint32_t t = min(seitBeginn, FOLIENZEIT_MS - 1);
    x = startX + (int32_t)(endX - startX) * t / (FOLIENZEIT_MS - 1);
  } else {
    x = (64 - f.breite) / 2;
  }
  u8g2.clearBuffer();
  u8g2.drawXBMP(x, y, f.breite, f.hoehe, f.bild);
  u8g2.sendBuffer();
}

void neueFolie(uint32_t jetzt) {
  folieBeginn = jetzt;
  Serial.printf("Folie %u/%u: %s\n", aktuelleFolie + 1, ANZAHL, folien[aktuelleFolie].titel);
  folieAnzeigen(0);
}

void setup() {
  Serial.begin(115200);
  rgb.begin();
  rgb.setBrightness(RGB_HELLIGKEIT);
  rgb.setPixelColor(0, regenbogenFarbe(0));
  rgb.show();
  letzterRgbSchritt = millis();
  delay(1200);
  Wire.begin(SDA_PIN, SCL_PIN);
  Wire.setClock(100000);
  // Erst Display-Adresse prüfen: funktioniert auch ohne angelötetes OLED.
  uint8_t adresse = 0;
  for (uint8_t test : {0x3C, 0x3D}) {
    Wire.beginTransmission(test);
    if (Wire.endTransmission() == 0) { adresse = test; break; }
  }
  if (adresse) {
    u8g2.setI2CAddress(adresse * 2); // U8g2 verwendet 8-bit-Adresse.
    u8g2.begin();
    oledGefunden = true;
    Serial.printf("OLED erkannt bei 0x%02X\n", adresse);
  } else {
    Serial.println("Kein OLED gefunden. Serielle Folien-Simulation laeuft.");
    Serial.println("SDA/SCL und Loetkontakte spaeter pruefen.");
  }
  neueFolie(millis());
}

void loop() {
  uint32_t jetzt = millis();
  rgbAktualisieren(jetzt);
  uint32_t vergangen = jetzt - folieBeginn;
  if (vergangen >= FOLIENZEIT_MS) {
    aktuelleFolie = (aktuelleFolie + 1) % ANZAHL;
    neueFolie(jetzt);
  } else if (oledGefunden && folien[aktuelleFolie].breite > 64) {
    // Breitere Sonderfolien (derzeit nicht verwendet).
    static uint32_t zuletztGemalt = 0;
    if (jetzt - zuletztGemalt >= 40) {
      zuletztGemalt = jetzt;
      folieAnzeigen(vergangen);
    }
  }
  delay(5);
}
